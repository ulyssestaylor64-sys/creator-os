# GLM API 配置（可选）
# 不配置 GLM_API_KEY 时，AI 相关接口返回 mock 结果
GLM_API_KEY=

# 可选：指定模型，默认 glm-5.3-flash；若不可用会自动尝试 glm-4-flash 等备用模型
# GLM_MODEL=glm-5.3-flash

# 存储模式（二选一）
# 1) 留空 = 本地 SQLite，路径由 CREATOROS_DB 指定（Render 挂盘时用 /var/data/creatoros.db）
# CREATOROS_DB=data/creatoros.db
# CREATOROS_PERSISTENT=1
# 2) 填 Postgres 连接串（Render Postgres / Supabase 等），填了就不再用 SQLite
# DATABASE_URL=postgresql://user:password@host:5432/dbname
